{
  "manifest_version": 3,
  "name": "Gupta Sabzi – Apps Price Reader",
  "version": "2.1",
  "description": "Blinkit / Zepto pe sabzi ke daam padh ke Gupta Sabzi Bhandar website ke liye compare + Excel export karta hai.",
  "permissions": ["storage", "tabs", "downloads", "alarms"],
  "host_permissions": [
    "https://blinkit.com/*", "https://*.blinkit.com/*",
    "https://www.zepto.com/*", "https://zepto.com/*",
    "https://www.zeptonow.com/*", "https://zeptonow.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Gupta Sabzi – Apps Prices" },
  "content_scripts": [{
    "matches": [
      "https://blinkit.com/*", "https://*.blinkit.com/*",
      "https://www.zepto.com/*", "https://zepto.com/*",
      "https://www.zeptonow.com/*", "https://zeptonow.com/*"
    ],
    "js": ["products-map.js", "content.js"],
    "run_at": "document_idle"
  }]
}
